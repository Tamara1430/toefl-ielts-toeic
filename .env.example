# ============================================================
# GROQ — AI (generate soal, TTS, STT, feedback speaking)
# Dapatkan di https://console.groq.com/keys
# ============================================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# SUPABASE — Database + Auth
# Dapatkan di Supabase Dashboard -> Project Settings -> API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PENTING: service_role key ini setara akses penuh ke database (bypass semua
# proteksi RLS). JANGAN PERNAH taruh di kode/frontend, hanya di sini (.env.local)
# dan di Environment Variables Vercel. Dapatkan di halaman API yang sama.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# CRON — dipakai untuk verifikasi request auto-generate soal
# Isi bebas, string acak yang sulit ditebak (contoh: hasil dari
# `openssl rand -hex 32` atau generator password online)
# ============================================================
CRON_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
